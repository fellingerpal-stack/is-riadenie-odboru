# auto = bez premenných zostane lokálne demo; cloud = bez Supabase premenných zobrazí konfiguračnú obrazovku
VITE_APP_MODE=auto

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Odporúčané pre nové projekty:
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Alternatíva pre projekty s pôvodným anon kľúčom:
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Verejná URL aplikácie pre pozvánky a obnovu hesla.
VITE_APP_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
