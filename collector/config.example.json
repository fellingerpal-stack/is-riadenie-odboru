{
  "supabase_url": "https://YOUR-PROJECT.supabase.co",
  "supabase_anon_key_env": "CVTI_SUPABASE_ANON_KEY",
  "collector_id": "PASTE-COLLECTOR-UUID-HERE",
  "collector_token_env": "CVTI_DISCOVERY_TOKEN",
  "cidrs": [
    "10.20.30.0/24"
  ],
  "tcp_ports": [
    22,
    80,
    443,
    445,
    515,
    631,
    9100,
    3389
  ],
  "workers": 16,
  "timeout_ms": 500,
  "max_hosts_per_cidr": 4096,
  "enrichment": {
    "enabled": true,
    "reverse_dns": true,
    "http": true,
    "https": true,
    "tls": true,
    "ssh_banner": true,
    "local_neighbor_mac": true,
    "classification": true,
    "max_banner_bytes": 4096,
    "timeout_ms": 800
  },
  "snmp": {
    "enabled": false,
    "probe_all": false,
    "collect_supplies": true,
    "community_env": "CVTI_SNMP_COMMUNITY",
    "binary": "snmpget"
  }
}
